{
  "format": 2,
  "about": "Routing policy vectors for llm-tiers. Each vector is one call to plan(request, providers, health, network). 'providers' is the app's configured order. Defaults: accepts [Public, Personal], vision false, jsonSchema false, maxContext 4096, quality 0.5, network Wifi, mode AppOrder, rank AppOrder, health Ready. 'data' lists the sensitivities of the request's data items. 'expect.steps' is the ordered plan; 'expect.skipped' maps provider id to the skip reason code. See testing/POLICY_VECTORS.md.",
  "providerSets": {
    "trio": [
      { "id": "home", "tier": "REMOTE", "vision": true, "jsonSchema": true, "maxContext": 32768 },
      { "id": "cloud", "tier": "REMOTE", "vision": true, "jsonSchema": true, "maxContext": 128000 },
      { "id": "nano", "tier": "ON_DEVICE" }
    ],
    "cloudPublicOnly": [
      { "id": "home", "tier": "REMOTE", "vision": true, "jsonSchema": true, "maxContext": 32768 },
      { "id": "cloud", "tier": "REMOTE", "accepts": ["Public"], "jsonSchema": true, "maxContext": 128000 },
      { "id": "nano", "tier": "ON_DEVICE" }
    ],
    "remotesPublicOnly": [
      { "id": "home", "tier": "REMOTE", "accepts": ["Public"] },
      { "id": "cloud", "tier": "REMOTE", "accepts": ["Public"] },
      { "id": "nano", "tier": "ON_DEVICE" }
    ],
    "graded": [
      { "id": "home", "tier": "REMOTE", "quality": 0.4 },
      { "id": "cloud", "tier": "REMOTE", "quality": 0.9 },
      { "id": "nano", "tier": "ON_DEVICE", "quality": 0.2 }
    ]
  },
  "vectors": [
    {
      "name": "app order is used when the request has no mode",
      "providers": "trio",
      "expect": { "steps": [{ "id": "home" }, { "id": "cloud" }, { "id": "nano" }] }
    },
    {
      "name": "PreferOnDevice moves on-device providers to the front and keeps the rest in app order",
      "providers": "trio",
      "request": { "mode": "PreferOnDevice" },
      "expect": { "steps": [{ "id": "nano" }, { "id": "home" }, { "id": "cloud" }] }
    },
    {
      "name": "PreferRemote moves remote providers to the front, in app order",
      "providers": [
        { "id": "nano", "tier": "ON_DEVICE" },
        { "id": "home", "tier": "REMOTE" },
        { "id": "cloud", "tier": "REMOTE" }
      ],
      "request": { "mode": "PreferRemote" },
      "expect": { "steps": [{ "id": "home" }, { "id": "cloud" }, { "id": "nano" }] }
    },
    {
      "name": "OnlyOnDevice excludes every remote provider: the user chose to stay on the device",
      "providers": "trio",
      "request": { "mode": "OnlyOnDevice" },
      "expect": {
        "steps": [{ "id": "nano" }],
        "skipped": { "home": "ExcludedByMode:OnlyOnDevice", "cloud": "ExcludedByMode:OnlyOnDevice" }
      }
    },
    {
      "name": "OnlyRemote excludes on-device providers and keeps every remote one",
      "providers": "trio",
      "request": { "mode": "OnlyRemote" },
      "expect": {
        "steps": [{ "id": "home" }, { "id": "cloud" }],
        "skipped": { "nano": "ExcludedByMode:OnlyRemote" }
      }
    },
    {
      "name": "Personal data needs approval for every remote provider, never for on-device",
      "providers": "trio",
      "request": { "data": ["Public", "Personal"] },
      "expect": {
        "steps": [
          { "id": "home", "needsApproval": true },
          { "id": "cloud", "needsApproval": true },
          { "id": "nano" }
        ]
      }
    },
    {
      "name": "Identifier items are removed before planning, so they change nothing",
      "providers": "trio",
      "request": { "data": ["Identifier", "Public"] },
      "expect": { "steps": [{ "id": "home" }, { "id": "cloud" }, { "id": "nano" }] }
    },
    {
      "name": "a provider that does not accept Personal data is skipped, not asked",
      "providers": "cloudPublicOnly",
      "request": { "data": ["Personal"] },
      "expect": {
        "steps": [{ "id": "home", "needsApproval": true }, { "id": "nano" }],
        "skipped": { "cloud": "SensitivityNotAccepted:Personal" }
      }
    },
    {
      "name": "privacy can leave no provider: nothing is planned rather than sent anyway",
      "providers": "remotesPublicOnly",
      "request": { "data": ["Personal"], "mode": "OnlyRemote" },
      "expect": {
        "steps": [],
        "skipped": {
          "home": "SensitivityNotAccepted:Personal",
          "cloud": "SensitivityNotAccepted:Personal",
          "nano": "ExcludedByMode:OnlyRemote"
        }
      }
    },
    {
      "name": "a provider that accepts only Personal data is skipped for a Public item",
      "providers": [
        { "id": "vault", "tier": "ON_DEVICE", "accepts": ["Personal"] },
        { "id": "cloud", "tier": "REMOTE" }
      ],
      "request": { "data": ["Public"] },
      "expect": { "steps": [{ "id": "cloud" }], "skipped": { "vault": "SensitivityNotAccepted:Public" } }
    },
    {
      "name": "privacy is decided before capability: the privacy reason is the one reported",
      "providers": "cloudPublicOnly",
      "request": { "data": ["Personal"], "vision": true },
      "expect": {
        "steps": [{ "id": "home", "needsApproval": true }],
        "skipped": { "cloud": "SensitivityNotAccepted:Personal", "nano": "MissingCapability:vision" }
      }
    },
    {
      "name": "a request with an image skips providers without vision",
      "providers": "trio",
      "request": { "vision": true },
      "expect": {
        "steps": [{ "id": "home" }, { "id": "cloud" }],
        "skipped": { "nano": "MissingCapability:vision" }
      }
    },
    {
      "name": "structured JSON output skips providers without JSON-schema support",
      "providers": "trio",
      "request": { "jsonSchema": true },
      "expect": {
        "steps": [{ "id": "home" }, { "id": "cloud" }],
        "skipped": { "nano": "MissingCapability:jsonSchema" }
      }
    },
    {
      "name": "a context requirement skips providers whose context is too short",
      "providers": "trio",
      "request": { "minContext": 64000 },
      "expect": {
        "steps": [{ "id": "cloud" }],
        "skipped": { "home": "MissingCapability:context", "nano": "MissingCapability:context" }
      }
    },
    {
      "name": "a pinned provider is the whole plan",
      "providers": "trio",
      "request": { "pin": "cloud" },
      "expect": { "steps": [{ "id": "cloud" }], "skipped": { "home": "NotPinned", "nano": "NotPinned" } }
    },
    {
      "name": "a pin is the user's explicit choice and overrides the mode",
      "providers": "trio",
      "request": { "pin": "nano", "mode": "OnlyRemote" },
      "expect": { "steps": [{ "id": "nano" }], "skipped": { "home": "NotPinned", "cloud": "NotPinned" } }
    },
    {
      "name": "a pinned provider that is cooling down is still tried: the user chose it",
      "providers": "trio",
      "request": { "pin": "home" },
      "health": { "home": { "state": "Out" } },
      "expect": { "steps": [{ "id": "home" }], "skipped": { "cloud": "NotPinned", "nano": "NotPinned" } }
    },
    {
      "name": "a pinned provider still needs approval for Personal data",
      "providers": "trio",
      "request": { "pin": "cloud", "data": ["Personal"] },
      "expect": {
        "steps": [{ "id": "cloud", "needsApproval": true }],
        "skipped": { "home": "NotPinned", "nano": "NotPinned" }
      }
    },
    {
      "name": "a pinned provider that cannot handle the request is not replaced",
      "providers": "trio",
      "request": { "pin": "nano", "vision": true },
      "expect": {
        "steps": [],
        "skipped": { "nano": "MissingCapability:vision", "home": "NotPinned", "cloud": "NotPinned" }
      }
    },
    {
      "name": "a pinned remote provider is skipped when offline, and nothing replaces it",
      "providers": "trio",
      "request": { "pin": "cloud" },
      "network": "None",
      "expect": { "steps": [], "skipped": { "cloud": "Offline", "home": "NotPinned", "nano": "NotPinned" } }
    },
    {
      "name": "a provider that is cooling down is skipped",
      "providers": "trio",
      "health": { "home": { "state": "Out" } },
      "expect": { "steps": [{ "id": "cloud" }, { "id": "nano" }], "skipped": { "home": "CoolingDown" } }
    },
    {
      "name": "Caution and Probing providers stay in the plan",
      "providers": "trio",
      "health": { "home": { "state": "Probing" }, "cloud": { "state": "Caution" } },
      "expect": { "steps": [{ "id": "home" }, { "id": "cloud" }, { "id": "nano" }] }
    },
    {
      "name": "offline (airplane mode) leaves only on-device providers, with no setting to change",
      "providers": "trio",
      "network": "None",
      "expect": { "steps": [{ "id": "nano" }], "skipped": { "home": "Offline", "cloud": "Offline" } }
    },
    {
      "name": "offline with OnlyRemote leaves nothing; mode is reported before health",
      "providers": "trio",
      "request": { "mode": "OnlyRemote" },
      "network": "None",
      "expect": {
        "steps": [],
        "skipped": { "home": "Offline", "cloud": "Offline", "nano": "ExcludedByMode:OnlyRemote" }
      }
    },
    {
      "name": "cellular is online: every remote provider is still planned",
      "providers": "trio",
      "network": "Cellular",
      "expect": { "steps": [{ "id": "home" }, { "id": "cloud" }, { "id": "nano" }] }
    },
    {
      "name": "a latency budget moves the first provider known to meet it to the front",
      "providers": "trio",
      "request": { "budgetFirstTokenMs": 1000 },
      "health": { "home": { "typicalFirstTokenMs": 3000 }, "cloud": { "typicalFirstTokenMs": 400 } },
      "expect": { "steps": [{ "id": "cloud" }, { "id": "home" }, { "id": "nano" }] }
    },
    {
      "name": "a latency budget changes nothing when the first choice has no history",
      "providers": "trio",
      "request": { "budgetFirstTokenMs": 1000 },
      "health": { "cloud": { "typicalFirstTokenMs": 400 } },
      "expect": { "steps": [{ "id": "home" }, { "id": "cloud" }, { "id": "nano" }] }
    },
    {
      "name": "a latency budget changes nothing when no provider is known to meet it",
      "providers": "trio",
      "request": { "budgetFirstTokenMs": 100 },
      "health": { "home": { "typicalFirstTokenMs": 3000 }, "cloud": { "typicalFirstTokenMs": 400 } },
      "expect": { "steps": [{ "id": "home" }, { "id": "cloud" }, { "id": "nano" }] }
    },
    {
      "name": "the budget applies after the mode: it reorders the mode's result",
      "providers": "trio",
      "request": { "mode": "PreferOnDevice", "budgetFirstTokenMs": 1000 },
      "health": { "nano": { "typicalFirstTokenMs": 2500 }, "home": { "typicalFirstTokenMs": 300 } },
      "expect": { "steps": [{ "id": "home" }, { "id": "nano" }, { "id": "cloud" }] }
    },
    {
      "name": "no providers gives an empty plan",
      "providers": [],
      "expect": { "steps": [] }
    },
    {
      "name": "rank Quality puts the highest declared quality first",
      "providers": "graded",
      "request": { "rank": "Quality" },
      "expect": { "steps": [{ "id": "cloud" }, { "id": "home" }, { "id": "nano" }] }
    },
    {
      "name": "rank Quality keeps the app's order between providers of equal quality",
      "providers": "trio",
      "request": { "rank": "Quality" },
      "expect": { "steps": [{ "id": "home" }, { "id": "cloud" }, { "id": "nano" }] }
    },
    {
      "name": "rank Speed puts the provider with the shortest learned time to first token first",
      "providers": "trio",
      "request": { "rank": "Speed" },
      "health": { "home": { "typicalFirstTokenMs": 3000 }, "cloud": { "typicalFirstTokenMs": 400 } },
      "expect": { "steps": [{ "id": "cloud" }, { "id": "nano" }, { "id": "home" }] }
    },
    {
      "name": "rank Speed with no history assumes 1 s on device and 2 s remote",
      "providers": "trio",
      "request": { "rank": "Speed" },
      "expect": { "steps": [{ "id": "nano" }, { "id": "home" }, { "id": "cloud" }] }
    },
    {
      "name": "rank Weighted with no weight on speed is the quality order",
      "providers": "graded",
      "request": { "rank": { "quality": 1, "speed": 0 } },
      "health": { "cloud": { "typicalFirstTokenMs": 9000 } },
      "expect": { "steps": [{ "id": "cloud" }, { "id": "home" }, { "id": "nano" }] }
    },
    {
      "name": "rank Weighted blends them: a fast, decent provider beats a slow, excellent one",
      "providers": [
        { "id": "excellent", "tier": "REMOTE", "quality": 0.9 },
        { "id": "decent", "tier": "REMOTE", "quality": 0.6 },
        { "id": "nano", "tier": "ON_DEVICE", "quality": 0.2 }
      ],
      "request": { "rank": { "quality": 1, "speed": 1 } },
      "health": { "excellent": { "typicalFirstTokenMs": 9000 }, "decent": { "typicalFirstTokenMs": 500 } },
      "expect": { "steps": [{ "id": "decent" }, { "id": "excellent" }, { "id": "nano" }] }
    },
    {
      "name": "the mode's preferred tier stays in front, with the ranking applied inside each group",
      "providers": "graded",
      "request": { "mode": "PreferOnDevice", "rank": "Quality" },
      "expect": { "steps": [{ "id": "nano" }, { "id": "cloud" }, { "id": "home" }] }
    },
    {
      "name": "ranking orders only the providers that passed the earlier rules",
      "providers": "graded",
      "request": { "rank": "Quality" },
      "health": { "cloud": { "state": "Out" } },
      "expect": { "steps": [{ "id": "home" }, { "id": "nano" }], "skipped": { "cloud": "CoolingDown" } }
    },
    {
      "name": "a pin is unaffected by ranking",
      "providers": "graded",
      "request": { "pin": "home", "rank": "Quality" },
      "expect": { "steps": [{ "id": "home" }], "skipped": { "cloud": "NotPinned", "nano": "NotPinned" } }
    },
    {
      "name": "the budget applies after the ranking",
      "providers": "graded",
      "request": { "rank": "Quality", "budgetFirstTokenMs": 1000 },
      "health": { "cloud": { "typicalFirstTokenMs": 3000 }, "home": { "typicalFirstTokenMs": 300 } },
      "expect": { "steps": [{ "id": "home" }, { "id": "cloud" }, { "id": "nano" }] }
    }
  ]
}
