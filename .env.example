# Copy to ".env" in this folder and fill in what you have. ".env" is ignored by git: never commit it.
# Gradle passes these to the opt-in contract tests (docs/CONTRACT_TESTS.md). A variable already set
# in the real environment wins over this file. Leave a line empty or commented to skip its tests.

# A LiteLLM, llama.cpp, Ollama or vLLM server on your network. Include the /v1 path.
LLM_TIERS_LAN_BASE_URL=
LLM_TIERS_LAN_MODEL=
# Only if the server needs a key.
LLM_TIERS_LAN_API_KEY=

# OpenRouter.
LLM_TIERS_OPENROUTER_API_KEY=
LLM_TIERS_OPENROUTER_MODEL=
